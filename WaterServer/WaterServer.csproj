<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Water.Host</RootNamespace>
    <AssemblyName>WaterServer</AssemblyName>
    <Description>Water host: dedicated server process and console.</Description>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WaterLib\WaterLib.csproj" />
    <ProjectReference Include="..\WaterAssembly\WaterAssembly.csproj" />
  </ItemGroup>
  <Target Name="BuildGameBits" BeforeTargets="Build">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\WaterLib\WaterLib.csproj" Properties="Configuration=$(Configuration);TargetFramework=net472" RemoveProperties="RuntimeIdentifier;SelfContained" Targets="Build" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\WaterSL\WaterSL.csproj" Properties="Configuration=$(Configuration);TargetFramework=net472" RemoveProperties="RuntimeIdentifier;SelfContained" Targets="Build" />
  </Target>
  <Target Name="StageGameAssemblies" AfterTargets="Build">
    <PropertyGroup>
      <_Lib472>$(MSBuildProjectDirectory)\..\WaterLib\bin\$(Configuration)\net472\WaterLib.dll</_Lib472>
      <_Sl472>$(MSBuildProjectDirectory)\..\WaterSL\bin\$(Configuration)\net472\WaterSL.dll</_Sl472>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)game" />
    <Copy SourceFiles="$(_Lib472);$(_Sl472)" DestinationFolder="$(OutputPath)game" SkipUnchangedFiles="true" Condition="Exists('$(_Lib472)') And Exists('$(_Sl472)')" />
  </Target>
  <Target Name="StagePublishedGameAssemblies" AfterTargets="Publish">
    <PropertyGroup>
      <_Lib472>$(MSBuildProjectDirectory)\..\WaterLib\bin\$(Configuration)\net472\WaterLib.dll</_Lib472>
      <_Sl472>$(MSBuildProjectDirectory)\..\WaterSL\bin\$(Configuration)\net472\WaterSL.dll</_Sl472>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)game" />
    <Copy SourceFiles="$(_Lib472);$(_Sl472)" DestinationFolder="$(PublishDir)game" SkipUnchangedFiles="true" Condition="Exists('$(_Lib472)') And Exists('$(_Sl472)')" />
  </Target>
</Project>
